# Public build settings for the REISUB Meeting client. Nothing secret goes
# here: this file is committed. If you run your own server, change these.
# Local overrides and secrets (Android signing) go in .env, which git
# ignores; see .env.example. Environment variables override both files.

# Host that serves the web app and invite links (https://<host>/j/<code>);
# such links open straight in the Android app. The meeting server must publish
# /.well-known/assetlinks.json on this host. Usually the host of the server's
# PUBLIC_WEB_URL.
REISUB_INVITE_HOST=meeting.reisub.xyz

# Download page for people who open an invite without the app installed.
REISUB_DOWNLOAD_URL=https://github.com/0xREISUB/REISUB_Meeting/releases/latest

# Project page, linked from the invite page and the Debian package.
REISUB_SOURCE_URL=https://github.com/0xREISUB/REISUB_Meeting

# The meeting server address users enter in the app (port 443 is implied by
# https). Invite links tell the installed app to use it: the invite page's
# "Open in app" button and, on Android, invite links on REISUB_INVITE_HOST.
REISUB_SERVER_URL=https://api.meeting.reisub.xyz

# Web build only: the meeting server for the web app, if the web app's own
# origin does not also serve the API (the API must then allow that origin
# with CORS). Leave empty when the server serves the web app itself.
REISUB_WEB_SERVER_URL=
