# Copy to .env (ignored by git) for local settings and secrets.
# Any key from app.env can be overridden here as well.

# Android release signing (required by `flutter build apk --release`).
REISUB_ANDROID_KEYSTORE=/home/you/.reisub-android-signing/reisub-meeting-release.jks
REISUB_ANDROID_STORE_PASSWORD=
REISUB_ANDROID_KEY_ALIAS=reisub-meeting
REISUB_ANDROID_KEY_PASSWORD=
